import gc
import json
import subprocess
import numpy as np
import pandas as pd
import scipy.sparse as sp
import matplotlib.pyplot as plt
from pathlib import Path
from xgboost import XGBClassifier
from sklearn.model_selection import (train_test_split, RandomizedSearchCV,
                                     GridSearchCV, StratifiedKFold)
from sklearn.metrics import (accuracy_score, precision_score, recall_score,
                             f1_score, roc_auc_score, average_precision_score,
                             matthews_corrcoef, confusion_matrix,
                             classification_report, precision_recall_curve)

# GPU if available, otherwise CPU
try:
    subprocess.check_output(["nvidia-smi"], stderr=subprocess.DEVNULL)
    DEVICE = "cuda"
except Exception:
    DEVICE = "cpu"
print("Device:", DEVICE)

TAG = "no_smote"
NAME = "XGBoost No SMOTE"

RANDOM_STATE = 42
TRAIN_NEG = 500_000
TUNE_NEG = 100_000
N_ITER = 8
VAL_EVAL_SIZE = 100_000
TEST_EVAL_SIZE = 200_000
DRIVE_DIR = Path("/content/drive/MyDrive/AML_Project")
TEST_IDX_PATH = DRIVE_DIR / "svm_eval_test_indices.npy"
OLD_TEST_IDX_PATH = Path("/content/svm_eval_test_indices.npy")

print("=" * 50)
print(NAME.upper())
print("=" * 50)

# ---- 0. Load data ----
if not DRIVE_DIR.exists():
    from google.colab import drive
    drive.mount('/content/drive')
DRIVE_DIR.mkdir(parents=True, exist_ok=True)

def unwrap(X):
    if isinstance(X, np.ndarray) and X.ndim == 0 and X.dtype == object:
        X = X.item()
    return X

files = ["X_train_selected.npz", "X_test_selected.npz", "y_train.npy", "y_test.npy"]
if all((DRIVE_DIR / f).exists() for f in files):
    print("Loading saved arrays from Drive...")
    X_train_selected = sp.load_npz(DRIVE_DIR / "X_train_selected.npz").tocsr()
    X_test_selected = sp.load_npz(DRIVE_DIR / "X_test_selected.npz").tocsr()
    y_train_arr = np.load(DRIVE_DIR / "y_train.npy").astype(np.int8)
    y_test_arr = np.load(DRIVE_DIR / "y_test.npy").astype(np.int8)
elif all(v in globals() for v in ["X_train_selected", "X_test_selected", "y_train", "y_test"]):
    print("Drive files not found. Using arrays in memory and saving them to Drive...")
    X_train_selected = sp.csr_matrix(unwrap(X_train_selected))
    X_test_selected = sp.csr_matrix(unwrap(X_test_selected))
    y_train_arr = np.asarray(y_train).astype(np.int8)
    y_test_arr = np.asarray(y_test).astype(np.int8)
    sp.save_npz(DRIVE_DIR / "X_train_selected.npz", X_train_selected)
    sp.save_npz(DRIVE_DIR / "X_test_selected.npz", X_test_selected)
    np.save(DRIVE_DIR / "y_train.npy", y_train_arr)
    np.save(DRIVE_DIR / "y_test.npy", y_test_arr)
else:
    raise RuntimeError("No saved arrays on Drive and none in memory. "
                       "Run the preprocessing script first.")
print("Train:", X_train_selected.shape, "| Test:", X_test_selected.shape)
print("Train class counts:", np.bincount(y_train_arr))

X_fit, X_val_full, y_fit, y_val_full = train_test_split(
    X_train_selected, y_train_arr, test_size=0.15,
    stratify=y_train_arr, random_state=RANDOM_STATE)

if VAL_EVAL_SIZE >= len(y_val_full):
    val_idx = np.arange(len(y_val_full))
else:
    val_idx, _ = train_test_split(np.arange(len(y_val_full)),
                                  train_size=VAL_EVAL_SIZE,
                                  stratify=y_val_full,
                                  random_state=RANDOM_STATE)
X_val, y_val = X_val_full[val_idx], y_val_full[val_idx]


if Path(TEST_IDX_PATH).exists():
    test_idx = np.load(TEST_IDX_PATH)
    print("Loaded saved test indices (Drive).")
elif OLD_TEST_IDX_PATH.exists():
    test_idx = np.load(OLD_TEST_IDX_PATH)
    np.save(TEST_IDX_PATH, test_idx)
    print("Loaded test indices from /content and copied them to Drive.")
else:
    if TEST_EVAL_SIZE >= len(y_test_arr):
        test_idx = np.arange(len(y_test_arr))
    else:
        test_idx, _ = train_test_split(np.arange(len(y_test_arr)),
                                       train_size=TEST_EVAL_SIZE,
                                       stratify=y_test_arr,
                                       random_state=RANDOM_STATE)
    np.save(TEST_IDX_PATH, test_idx)
    print("Test indices created and saved.")
X_test_e, y_test_e = X_test_selected[test_idx], y_test_arr[test_idx]
print("Validation:", X_val.shape, "| fraud:", int(y_val.sum()))
print("Test      :", X_test_e.shape, "| fraud:", int(y_test_e.sum()))

# ---- 3. Shared subsets (identical seeds: tune=42, train=7) ----
def make_subset(X, y, n_neg, seed):
    pos = np.where(y == 1)[0]
    neg = np.where(y == 0)[0]
    r = np.random.RandomState(seed)
    chosen = r.choice(neg, size=min(n_neg, len(neg)), replace=False)
    idx = np.concatenate([pos, chosen])
    r.shuffle(idx)
    return X[idx], y[idx]

X_tune, y_tune = make_subset(X_fit, y_fit, TUNE_NEG, seed=42)
X_sub, y_sub = make_subset(X_fit, y_fit, TRAIN_NEG, seed=7)
print("\nTuning subset  :", X_tune.shape, np.bincount(y_tune))
print("Training subset:", X_sub.shape, np.bincount(y_sub))

def dense(X):
    return (X.toarray() if sp.issparse(X) else np.asarray(X)).astype(np.float32)

X_tune, X_sub, X_val, X_test_e = map(dense, [X_tune, X_sub, X_val, X_test_e])

def best_f1_threshold(y_true, score):
    p, r, t = precision_recall_curve(y_true, score)
    p, r = p[:-1], r[:-1]
    f1 = 2 * p * r / (p + r + 1e-12)
    b = int(np.argmax(f1))
    return float(t[b]), float(f1[b])

def compute_metrics(y_true, score, thr):
    pred = (score >= thr).astype(int)
    return {
        "Accuracy": accuracy_score(y_true, pred),
        "Precision": precision_score(y_true, pred, zero_division=0),
        "Recall": recall_score(y_true, pred, zero_division=0),
        "F1": f1_score(y_true, pred, zero_division=0),
        "ROC-AUC": roc_auc_score(y_true, score),
        "PR-AUC": average_precision_score(y_true, score),
        "MCC": matthews_corrcoef(y_true, pred),
    }

def xgb_score(model, X):
    return model.predict_proba(X)[:, 1]

def new_xgb(**params):
    return XGBClassifier(objective="binary:logistic", eval_metric="aucpr",
                         tree_method="hist", device=DEVICE,
                         random_state=RANDOM_STATE, n_jobs=2, verbosity=0,
                         **params)

cv = StratifiedKFold(n_splits=3, shuffle=True, random_state=RANDOM_STATE)

# ---- 5. Class-imbalance handling WITHOUT SMOTE ----
# Candidate scale_pos_weight values: none, sqrt(ratio), full ratio.
ratio = float((y_sub == 0).sum() / max((y_sub == 1).sum(), 1))
spw_options = sorted({1.0, round(float(np.sqrt(ratio)), 2), round(ratio, 2)})
print(f"\nNeg/Pos ratio in training subset: {ratio:.2f}")
print("scale_pos_weight options:", spw_options)

# ---- 6. Baseline: fixed settings, no class weights, no SMOTE ----
xgb_baseline = new_xgb(n_estimators=300, learning_rate=0.1, max_depth=6)
xgb_baseline.fit(X_sub, y_sub)
print("Baseline XGBoost (No SMOTE) trained.")

# ---- 7. Tuning (same search space/budget; scale_pos_weight added) ----
random_params = {
    "n_estimators": [200, 300, 400],
    "learning_rate": [0.03, 0.05, 0.1],
    "max_depth": [4, 6, 8],
    "min_child_weight": [1, 5, 10],
    "subsample": [0.7, 0.8, 1.0],
    "colsample_bytree": [0.6, 0.8, 1.0],
    "reg_lambda": [1, 5, 10],
    "scale_pos_weight": spw_options,
}
random_search = RandomizedSearchCV(
    new_xgb(), random_params, n_iter=N_ITER, scoring="average_precision",
    cv=cv, n_jobs=1, random_state=RANDOM_STATE, verbose=1)
random_search.fit(X_tune, y_tune)
rb = dict(random_search.best_params_)
print("\nRandom Search best params:", rb)
print("Random Search best CV PR-AUC:", round(random_search.best_score_, 4))

depth = rb["max_depth"]
mcw = rb["min_child_weight"]
grid_params = {
    "max_depth": sorted({max(2, depth - 1), depth, min(10, depth + 1)}),
    "min_child_weight": sorted({mcw, mcw * 2}),
}
fixed = {k: v for k, v in rb.items() if k not in ("max_depth", "min_child_weight")}
grid_search = GridSearchCV(
    new_xgb(**fixed), grid_params, scoring="average_precision",
    cv=cv, n_jobs=1, verbose=1)
grid_search.fit(X_tune, y_tune)
print("\nGrid Search best params:", grid_search.best_params_)
print("Grid Search best CV PR-AUC:", round(grid_search.best_score_, 4))

best_params = {**rb, **grid_search.best_params_}
del X_tune, y_tune
gc.collect()

# ---- 8. Final tuned model on the raw (un-oversampled) training subset ----
xgb_tuned = new_xgb(**best_params)
xgb_tuned.fit(X_sub, y_sub)
print("\nTuned XGBoost (No SMOTE) trained. Params:", best_params)
del X_sub, y_sub
gc.collect()

# ---- 9. Evaluation ----
models = {f"{NAME} (baseline)": xgb_baseline,
          f"{NAME} (tuned)": xgb_tuned}
val_score = {n: xgb_score(m, X_val) for n, m in models.items()}
test_score = {n: xgb_score(m, X_test_e) for n, m in models.items()}

thr = {}
for n in models:
    thr[n], vf1 = best_f1_threshold(y_val, val_score[n])
    print(f"{n}: best validation threshold = {thr[n]:.4f} (val F1 = {vf1:.4f})")

tuned_tbl = pd.DataFrame({n: compute_metrics(y_test_e, test_score[n], thr[n])
                          for n in models})
default_tbl = pd.DataFrame({n: compute_metrics(y_test_e, test_score[n], 0.5)
                            for n in models})

print("\n=== TEST RESULTS: threshold tuned on validation ===")
display(tuned_tbl.round(4))
print("\n=== TEST RESULTS: default threshold (probability >= 0.5) ===")
display(default_tbl.round(4))

cms = {}
for n in models:
    pred = (test_score[n] >= thr[n]).astype(int)
    print("\n" + "=" * 50)
    print(n, "- tuned threshold", round(thr[n], 4))
    print("=" * 50)
    print(classification_report(y_test_e, pred, digits=4, zero_division=0,
                                target_names=["Legitimate", "Laundering"]))
    cms[n] = confusion_matrix(y_test_e, pred)
    print("Confusion matrix [[TN FP],[FN TP]]:\n", cms[n])

# ---- 10. Plots ----
fig, axes = plt.subplots(1, 3, figsize=(18, 5))
for ax, (n, cm) in zip(axes[:2], cms.items()):
    norm = cm / cm.sum(axis=1, keepdims=True)
    ax.imshow(norm, vmin=0, vmax=1)
    ax.set_title(n)
    ax.set_xlabel("Predicted"); ax.set_ylabel("Actual")
    ax.set_xticks([0, 1]); ax.set_xticklabels(["Legit", "Laundering"])
    ax.set_yticks([0, 1]); ax.set_yticklabels(["Legit", "Laundering"])
    for i in range(2):
        for j in range(2):
            ax.text(j, i, f"{cm[i, j]}\n({norm[i, j]:.1%})", ha="center",
                    va="center", color="white" if norm[i, j] < 0.5 else "black")
for n in models:
    p, r, _ = precision_recall_curve(y_test_e, test_score[n])
    ap = average_precision_score(y_test_e, test_score[n])
    axes[2].plot(r, p, label=f"{n} (PR-AUC={ap:.3f})")
axes[2].set_xlabel("Recall"); axes[2].set_ylabel("Precision")
axes[2].set_title("Precision-Recall (test)"); axes[2].legend(); axes[2].grid()
plt.tight_layout(); plt.show()

# ---- 10b. Feature importance sanity check ----
try:
    info = pd.read_csv(DRIVE_DIR / "selected_features.csv")
    feat_names = info.loc[info["Selected"], "Feature"].tolist()
except Exception:
    feat_names = [f"f{i}" for i in range(X_test_e.shape[1])]
imp = pd.Series(xgb_tuned.feature_importances_, index=feat_names[:X_test_e.shape[1]]) \
        .sort_values(ascending=False)
print("\nTop features (one dominant feature would suggest leakage):")
print(imp.head(10).round(4))

# ---- 11. Save ----
tuned_tbl.round(6).to_csv(DRIVE_DIR / f"results_xgboost_{TAG}_tuned_threshold.csv")
default_tbl.round(6).to_csv(DRIVE_DIR / f"results_xgboost_{TAG}_default_threshold.csv")
xgb_tuned.save_model(str(DRIVE_DIR / f"aml_xgboost_{TAG}_tuned.json"))
with open(DRIVE_DIR / f"xgboost_{TAG}_threshold.json", "w") as f:
    json.dump({"thresholds": thr,
               "best_params": {k: str(v) for k, v in best_params.items()}}, f, indent=2)
print("\nSaved results, model and thresholds to", DRIVE_DIR)

del X_fit, y_fit, X_val_full, y_val_full
gc.collect()

print("\n" + "=" * 50)
print(NAME.upper() + " COMPLETED")
print("=" * 50)
